# ============================================================================
# IHS Cloud Engine — Environment Variables
# Copy to `.env` for local development. In EKS, inject via Secrets/ConfigMaps.
# ============================================================================

# Runtime
NODE_ENV=development
PORT=8080

# Local demo data plane (in-memory + Prisma dual-write)
IHS_DEMO_MODE=true

# SQLite persistence (local). Production may use Postgres RDS.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://ihs:ihs@localhost:5432/ihs_cloud_engine?schema=public"

# Twilio SMS (optional — console fallback when unset/invalid)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_STANDBY_DRIVER_PHONE=
DEMO_ALERT_PHONE="+919876543210"

# JWT cryptographic secret for HTTP-Only cookie sessions (ihs_auth_token)
# MUST match apps/web-portals JWT_SECRET_KEY used by Edge middleware
JWT_SECRET_KEY="replace-with-production-secret-min-32-chars"

# AWS — region for S3 Glacier Day-31 cold vault migration (DPDP / NMC WORM)
AWS_REGION="ap-south-2"
GLACIER_BUCKET="ihs-antp-cold-vault-wrm"

# AWS credentials (local/dev only — prefer IRSA / instance roles in EKS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: Mapbox (if serving any map-adjacent server routes)
# Client-side portals use NEXT_PUBLIC_MAPBOX_TOKEN instead
MAPBOX_TOKEN=

# Optional: WebSocket / public endpoint overrides
PUBLIC_WS_BASE_URL="ws://localhost:8080"
PUBLIC_API_BASE_URL="http://localhost:8080"
