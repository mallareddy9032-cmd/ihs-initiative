{
  "name": "ihs-cloud-engine",
  "version": "1.0.0",
  "description": "IHS Master FSM, WebSocket Hub, and Web Portals",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--max-old-space-size=1024\" ts-node --project tsconfig.server.json src/server.ts",
    "dev:lite": "NODE_OPTIONS=\"--max-old-space-size=1024\" ts-node --project tsconfig.server.json src/server.ts",
    "build": "prisma generate && tsc --project tsconfig.server.json",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.server.json",
    "start": "NODE_OPTIONS=\"--max-old-space-size=1024\" node dist/server.js",
    "test:ci": "jest --passWithNoTests",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "ts-node --project tsconfig.server.json prisma/seed.ts",
    "test:stress": "ts-node --project tsconfig.server.json src/scripts/stress-test.ts",
    "test:audit-chain": "ts-node --project tsconfig.server.json src/scripts/verify-audit-chain.ts"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.server.json prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.400.0",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mapbox-gl": "^2.15.0",
    "next": "14.0.0",
    "node-cron": "^3.0.2",
    "prom-client": "^15.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "twilio": "^5.13.1",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.7",
    "@types/react": "^18.2.0",
    "@types/ws": "^8.5.5",
    "autoprefixer": "^10.4.15",
    "jest": "^29.6.0",
    "postcss": "^8.4.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.3.3",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6"
  }
}
