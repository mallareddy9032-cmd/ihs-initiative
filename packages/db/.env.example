# Shared @ihs/db — PostgreSQL hot store
DATABASE_URL=postgresql://IHS_DB_USER:IHS_DB_PASSWORD@localhost:5432/ihs_core_db?schema=public

# Force in-memory mock even when DATABASE_URL is set
# IHS_DB_MOCK=true

# Razorpay keys are consumed by apps; listed here for monorepo discoverability
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
