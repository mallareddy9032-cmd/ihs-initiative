# ============================================================================
# IHS Phase 5 — Production Environment Contract
# Copy to deployment secret store / ECS task env / EKS ConfigMap+Secret.
# NEVER commit real credentials.
# ============================================================================

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
NODE_ENV=production
# patient-portal=3000 | operations-hub=3001 | clinical-workspace=3002
PORT=3000
HOSTNAME=0.0.0.0
LOG_LEVEL=info
NEXT_TELEMETRY_DISABLED=1

# ----------------------------------------------------------------------------
# Database (PostgreSQL hot store — @ihs/db / Prisma)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://IHS_DB_USER:IHS_DB_PASSWORD@ihs-antp-prod-db.xxxxx.ap-south-2.rds.amazonaws.com:5432/ihs_core_db?schema=public&sslmode=require
# Force in-memory mock ONLY for ephemeral preview environments (never production):
IHS_DB_MOCK=false

# ----------------------------------------------------------------------------
# IAM / OIDC (AWS IRSA + Cognito / enterprise IdP)
# ----------------------------------------------------------------------------
AWS_REGION=ap-south-2
AWS_ACCOUNT_ID=123456789012
# EKS service-account role ARN assumed via OIDC (preferred over static keys)
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/ihs-antp-portal-irsa
AWS_WEB_IDENTITY_TOKEN_FILE=/var/run/secrets/eks.amazonaws.com/serviceaccount/token
# OIDC issuer for portal session federation (Cognito / Auth0 / enterprise)
OIDC_ISSUER_URL=https://cognito-idp.ap-south-2.amazonaws.com/ap-south-2_XXXXXXXXX
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=ihs-portals
# Must match Cloud Engine HS256 signing secret for cookie/JWT verification
JWT_SECRET_KEY=

# ----------------------------------------------------------------------------
# Auth session cookies (Phase 3+)
# ----------------------------------------------------------------------------
# Cookie name is __ihs_at (httpOnly). TTL is enforced in @ihs/auth-client.
AUTH_COOKIE_SECURE=true

# ----------------------------------------------------------------------------
# Upstream Cloud Engine / realtime
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://api.ihs.antp.init
NEXT_PUBLIC_WS_DISPATCH_URL=wss://ws.ihs.antp.init/v1/dispatch/stream
NEXT_PUBLIC_WS_TELEMETRY_URL=wss://ws.ihs.antp.init/v1/telemetry/stream
NEXT_PUBLIC_WS_PATIENT_URL=wss://ws.ihs.antp.init/v1/patient/stream

# ----------------------------------------------------------------------------
# Object storage & DPDP cold vault (S3 / Glacier WORM)
# ----------------------------------------------------------------------------
S3_VAULT_BUCKET=ihs-antp-hot-vault
S3_VAULT_PREFIX=vault/prod/
GLACIER_BUCKET=ihs-antp-cold-vault-wrm
GLACIER_VAULT_PREFIX=cold/prod/
# Optional SSE-KMS for vault objects
S3_KMS_KEY_ARN=arn:aws:kms:ap-south-2:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AWS_S3_REGION=ap-south-2

# ----------------------------------------------------------------------------
# GIS / Map bindings (operations-hub)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...
MAPBOX_STYLE_URL=mapbox://styles/mapbox/dark-v11

# ----------------------------------------------------------------------------
# App identity (set per deployment / container)
# ----------------------------------------------------------------------------
# IHS_APP_NAME=patient-portal | clinical-workspace | operations-hub
IHS_APP_NAME=patient-portal
IHS_ENVIRONMENT=production
IHS_PILOT_ZONE=ananthapuramu

# ----------------------------------------------------------------------------
# Razorpay Commercial Billing
# ----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.ihs.antp.init
OTEL_SERVICE_NAME=ihs-patient-portal
ENABLE_FLEET_COMPLIANCE_CRON=true
ENABLE_GLACIER_MIGRATION_CRON=true
