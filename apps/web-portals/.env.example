NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token
# Optional — leave as placeholder to use free OpenStreetMap/Leaflet dual-pin map.
# Set a real Mapbox token only if you want Mapbox dark-v11 instead.
