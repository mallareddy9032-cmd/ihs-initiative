NEXT_PUBLIC_WS_DISPATCH_URL=ws://localhost:8080/v1/dispatch/stream
NEXT_PUBLIC_WS_TELEMETRY_URL=ws://localhost:8080/v1/telemetry/stream
JWT_SECRET_KEY=dev-only-change-me
