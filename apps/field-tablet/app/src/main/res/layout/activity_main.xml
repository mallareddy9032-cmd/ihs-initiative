<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#111111">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#F44336"
        android:textStyle="bold"
        android:textSize="22sp"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Ready"
        android:textColor="#EEEEEE"
        android:textSize="14sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/pendingCountText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Pending sync: 0"
        android:textColor="#90CAF9"
        android:textSize="14sp"
        android:fontFamily="monospace" />

    <Button
        android:id="@+id/btnStartScanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/start_scanner" />

    <Button
        android:id="@+id/btnStopScanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/stop_scanner" />

    <Button
        android:id="@+id/btnSyncNow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/sync_now" />
</LinearLayout>
