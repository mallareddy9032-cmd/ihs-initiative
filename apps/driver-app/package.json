{
  "name": "ihs-driver-app",
  "version": "1.0.0",
  "private": true,
  "description": "IHS Ambulance Driver Mobile Web App",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--max-old-space-size=1024\" vite --port 3002 --host",
    "dev:lite": "NODE_OPTIONS=\"--max-old-space-size=1024\" vite --port 3002 --host",
    "build": "tsc -b && vite build",
    "preview": "NODE_OPTIONS=\"--max-old-space-size=1024\" vite preview --port 3002",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.1.6",
    "vite": "^5.4.11"
  }
}
