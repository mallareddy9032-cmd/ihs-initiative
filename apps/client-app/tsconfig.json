{
  "extends": "@tsconfig/react-native/tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "lib": ["ES2020"],
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "jsx": "react-native",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["react-native"]
  },
  "include": ["src/**/*", "index.js"],
  "exclude": ["node_modules", "android", "ios", "babel.config.js", "metro.config.js", "src/web/**/*", "src/main.web.tsx", "src/App.web.tsx", "src/**/*.web.tsx", "src/**/*.web.ts"]
}
