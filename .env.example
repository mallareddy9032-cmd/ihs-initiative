# ============================================================================
# IHS Monorepo — Environment Variable Contract
# Copy to the appropriate service `.env` / `.env.local` and fill secrets.
# NEVER commit real credentials.
# ============================================================================

# ----------------------------------------------------------------------------
# Shared / AWS Infrastructure (GitHub Actions secrets + runtime IAM)
# ----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-2
AWS_ACCOUNT_ID=

# ECR / EKS deployment targets
ECR_REPOSITORY=ihs-cloud-engine
EKS_CLUSTER_NAME=ihs-antp-cluster
EKS_NAMESPACE=ihs-production

# ----------------------------------------------------------------------------
# Cloud Engine (services/cloud-engine) — Express + Prisma + WebSockets + Cron
# ----------------------------------------------------------------------------
NODE_ENV=production
PORT=8080

# PostgreSQL Hot Store (RDS Multi-AZ, ap-south-2)
DATABASE_URL=postgresql://IHS_DB_USER:IHS_DB_PASSWORD@ihs-antp-prod-db.xxxxx.ap-south-2.rds.amazonaws.com:5432/ihs_core_db?schema=public&sslmode=require

# JWT session signing (HTTP-Only cookie `ihs_auth_token`, HS256, 12h TTL)
JWT_SECRET_KEY=

# Day-31 DPDP Glacier migration daemon
GLACIER_BUCKET=ihs-antp-cold-vault-wrm
# Optional override if not using instance/task role credentials:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ----------------------------------------------------------------------------
# Web Portals (apps/web-portals) — Legacy Next.js Command Center & Physician Console
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://api.ihs.antp.init
NEXT_PUBLIC_WS_DISPATCH_URL=wss://ws.ihs.antp.init/v1/dispatch/stream
NEXT_PUBLIC_WS_TELEMETRY_URL=wss://ws.ihs.antp.init/v1/telemetry/stream
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...
# Must match Cloud Engine JWT_SECRET_KEY for Edge middleware verification
# JWT_SECRET_KEY=

# ----------------------------------------------------------------------------
# Phase 2 Consolidated Apps (npm workspaces)
# apps/patient-portal :3000 | apps/clinical-workspace :3002 | apps/operations-hub :3001
# Shared packages: @ihs/types, @ihs/auth-client
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=https://api.ihs.antp.init
# JWT_SECRET_KEY=
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ...   # operations-hub GIS only

# ----------------------------------------------------------------------------
# Razorpay Commercial Billing (shared across Phase 2 apps)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Field Tablet (apps/field-tablet) — BuildConfig / Retrofit base URL
# ----------------------------------------------------------------------------
# API_BASE_URL is injected via Gradle BuildConfig (default emulator: http://10.0.2.2:8080)
FIELD_TABLET_API_BASE_URL=https://api.ihs.antp.init

# ----------------------------------------------------------------------------
# Client Mobile App (apps/client-app) — Panic WSS + AES SMS fallback
# ----------------------------------------------------------------------------
IHS_PANIC_WSS_URL=wss://ws.ihs.antp.init/v1/triage/panic
IHS_GSM_SHORTCODE=+919876543210
# Per-enrollment AES-256 key provisioned into secure storage (never hardcode in prod)
IHS_CLIENT_AES_KEY=

# ----------------------------------------------------------------------------
# Optional observability / feature flags
# ----------------------------------------------------------------------------
LOG_LEVEL=info
ENABLE_FLEET_COMPLIANCE_CRON=true
ENABLE_GLACIER_MIGRATION_CRON=true
